# 复制成 .env 后按需修改。所有变量都有开发默认值（见 src/lib/config.ts），
# 生产部署必须显式覆盖，尤其是下面标了 [必改] 的。
#
# 命名注意：数据库变量叫 LICENSE_DB_URL 而不是 DATABASE_URL —— 避免继承到
# 环境中残留的、指向别处的同名变量（这个坑真实踩过，表现为 P1001 ECONNREFUSED）。

# [必改] PostgreSQL 连接串
LICENSE_DB_URL=postgresql://licensing:licensing_dev_pw@127.0.0.1:55432/licensing?schema=public

# [必改] 会话签名密钥（>= 32 字节随机串）
SESSION_SECRET=dev-only-session-secret-please-change-in-production-32bytes

# [必改] 授权码 HMAC pepper（换掉会让所有已生成的授权码哈希失效）
LICENSE_HMAC_PEPPER=dev-only-license-hmac-pepper-please-change-in-production

# [必改] 站点地址，用于重置密码链接与 Cookie Secure 判定
APP_BASE_URL=http://127.0.0.1:3000

# 部署环境：production / sandbox / development
# Sandbox 必须使用独立数据库、独立 SIGNING_KEY_DIR、独立产品凭证。
DEPLOYMENT_ENV=development

# Ed25519 签名密钥目录（生产的私钥不要与开发共用）
SIGNING_KEY_DIR=.keys

# 服务端断言的 audience
ASSERTION_AUDIENCE=license-api

# 开发环境把重置密码链接直接返回给前端；生产必须 false
DEV_MAIL_SINK=true

# Webhook 投递器
WEBHOOK_INTERVAL_MS=5000
DISABLE_WEBHOOK_WORKER=false
