  auth_method                                                                                       backup_auth_method           @default(none)
  credential_id                                                                                     String?                      @db.Uuid
  tls_verify                                                                                        Boolean                      @default(true)
  enabled                                                                                           Boolean                      @default(true)
  priority                                                                                          Int                          @default(100)
  is_required                                                                                       Boolean                      @default(true)
  capability_snapshot                                                                               Json                         @default("{}")
  last_tested_at                                                                                    DateTime?                    @db.Timestamptz(6)
  last_test_status                                                                                  backup_test_status           @default(untested)
  last_test_error_code                                                                              String?                      @db.VarChar(80)
  last_test_error                                                                                   String?
  created_at                                                                                        DateTime                     @default(now()) @db.Timestamptz(6)
  updated_at                                                                                        DateTime                     @default(now()) @db.Timestamptz(6)
  backup_job_targets                                                                                backup_job_targets[]
  backup_policy_targets                                                                             backup_policy_targets[]
  backup_restore_tests                                                                              backup_restore_tests[]
  backup_storage_credentials_backup_storage_credentials_destination_idTobackup_storage_destinations backup_storage_credentials[] @relation("backup_storage_credentials_destination_idTobackup_storage_destinations")
  backup_storage_credentials_backup_storage_destinations_credential_idTobackup_storage_credentials  backup_storage_credentials?  @relation("backup_storage_destinations_credential_idTobackup_storage_credentials", fields: [credential_id], references: [id], onUpdate: NoAction, map: "backup_storage_destinations_credential_fk")
  organizations                                                                                     organizations                @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([organization_id, name])
}

model customer_identities {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String            @db.Uuid
  customer_id     String            @db.Uuid
  product_id      String            @db.Uuid
  provider        identity_provider
  subject_hash    Bytes
  display_name    String?           @db.VarChar(160)
  status          identity_status   @default(active)
  verified_at     DateTime?         @db.Timestamptz(6)
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  customers       customers         @relation(fields: [customer_id, organization_id], references: [id, organization_id], onDelete: NoAction, onUpdate: NoAction)
  products        products          @relation(fields: [product_id, organization_id], references: [id, organization_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([id, organization_id])
  @@unique([product_id, provider, subject_hash])
  @@index([customer_id, status], map: "idx_customer_identities_customer")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model customers {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id     String                @db.Uuid
  customer_code       String?               @db.VarChar(80)
  name                String                @db.VarChar(160)
  email               String?               @db.VarChar(254)
  phone               String?               @db.VarChar(40)
  company_name        String?               @db.VarChar(160)
  notes               String?
  status              record_status         @default(active)
  metadata            Json                  @default("{}")
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @default(now()) @db.Timestamptz(6)
  customer_identities customer_identities[]
  organizations       organizations         @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  licenses            licenses[]

  @@unique([id, organization_id])
  @@unique([organization_id, customer_code], map: "uq_customers_org_code", where: raw("(customer_code IS NOT NULL)"))
  @@index([organization_id, name], map: "idx_customers_org_name")
}

model devices {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id       String        @db.Uuid
  product_id            String        @db.Uuid
  device_instance_id    String        @db.VarChar(120)
  platform              String        @db.VarChar(40)
  device_name           String?       @db.VarChar(160)
  public_key            Bytes?
  public_key_thumbprint String?       @db.VarChar(128)
  fingerprint_hash      Bytes?
  status                record_status @default(active)
  first_seen_at         DateTime      @default(now()) @db.Timestamptz(6)
  last_seen_at          DateTime?     @db.Timestamptz(6)
  metadata              Json          @default("{}")
  activations           activations[]
  products              products      @relation(fields: [product_id, organization_id], references: [id, organization_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([id, organization_id])
  @@unique([product_id, device_instance_id])
  @@index([product_id, fingerprint_hash], map: "idx_devices_fingerprint", where: raw("(fingerprint_hash IS NOT NULL)"))
  @@index([product_id, status, last_seen_at(sort: Desc)], map: "idx_devices_product_status")
}

model idempotency_records {
  id              BigInt   @id @default(autoincrement())
  organization_id String   @db.Uuid
  product_id      String   @db.Uuid
  scope           String   @db.VarChar(120)
  idempotency_key String   @db.VarChar(120)
  request_hash    Bytes
  response_status Int?
  response_body   Json?
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  expires_at      DateTime @db.Timestamptz(6)

  @@unique([product_id, scope, idempotency_key])
  @@index([expires_at], map: "idx_idempotency_expiry")
}

model license_features {
  license_id       String           @db.Uuid
  product_id       String           @db.Uuid
  organization_id  String           @db.Uuid
  feature_code     String           @db.VarChar(100)
  feature_value    Json
  updated_at       DateTime         @default(now()) @db.Timestamptz(6)
  licenses         licenses         @relation(fields: [license_id, product_id, organization_id], references: [id, product_id, organization_id], onDelete: NoAction, onUpdate: NoAction)
  product_features product_features @relation(fields: [product_id, feature_code], references: [product_id, code], onDelete: NoAction, onUpdate: NoAction)

  @@id([license_id, feature_code])
}

model license_keys {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id   String        @db.Uuid
  license_id        String        @db.Uuid
  key_prefix        String        @db.VarChar(16)
  key_last4         String        @db.VarChar(4)
  key_hash          Bytes         @unique
  hash_key_version  String        @db.VarChar(40)
  status            record_status @default(active)
  valid_until       DateTime?     @db.Timestamptz(6)
  first_redeemed_at DateTime?     @db.Timestamptz(6)
  created_at        DateTime      @default(now()) @db.Timestamptz(6)
  revoked_at        DateTime?     @db.Timestamptz(6)
  licenses          licenses      @relation(fields: [license_id, organization_id], references: [id, organization_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([license_id, status], map: "idx_license_keys_license")
  @@index([key_prefix, key_last4], map: "idx_license_keys_prefix")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model license_renewals {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id      String        @db.Uuid
  license_id           String        @db.Uuid
  duration_unit        duration_unit
  duration_value       Int
  previous_expires_at  DateTime?     @db.Timestamptz(6)
  renewal_starts_at    DateTime      @db.Timestamptz(6)
