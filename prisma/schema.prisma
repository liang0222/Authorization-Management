generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model activation_challenges {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id    String    @db.Uuid
  product_id         String    @db.Uuid
  challenge_id       String    @unique @db.Uuid
  nonce              String
  device_instance_id String    @db.VarChar(120)
  expires_at         DateTime  @db.Timestamptz(6)
  consumed_at        DateTime? @db.Timestamptz(6)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  products           products  @relation(fields: [product_id, organization_id], references: [id, organization_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([expires_at], map: "idx_activation_challenges_expiry")
}

model activation_events {
  id              BigInt      @id @default(autoincrement())
  organization_id String      @db.Uuid
  activation_id   String      @db.Uuid
  event_type      String      @db.VarChar(60)
  actor_type      String      @db.VarChar(30)
  actor_id        String?     @db.Uuid
  request_id      String?     @db.VarChar(100)
  ip              String?     @db.Inet
  details         Json        @default("{}")
  created_at      DateTime    @default(now()) @db.Timestamptz(6)
  activations     activations @relation(fields: [activation_id, organization_id], references: [id, organization_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([activation_id, created_at(sort: Desc)], map: "idx_activation_events_activation")
}

model activation_refresh_tokens {
  id                              String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id                 String                      @db.Uuid
  activation_id                   String                      @db.Uuid
  token_family_id                 String                      @db.Uuid
  token_hash                      Bytes                       @unique
  issued_at                       DateTime                    @default(now()) @db.Timestamptz(6)
  expires_at                      DateTime                    @db.Timestamptz(6)
  used_at                         DateTime?                   @db.Timestamptz(6)
  revoked_at                      DateTime?                   @db.Timestamptz(6)
  replaced_by                     String?                     @db.Uuid
  activations                     activations                 @relation(fields: [activation_id, organization_id], references: [id, organization_id], onDelete: NoAction, onUpdate: NoAction)
  activation_refresh_tokens       activation_refresh_tokens?  @relation("activation_refresh_tokensToactivation_refresh_tokens", fields: [replaced_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_activation_refresh_tokens activation_refresh_tokens[] @relation("activation_refresh_tokensToactivation_refresh_tokens")

  @@index([activation_id, issued_at(sort: Desc)], map: "idx_refresh_tokens_activation")
  @@index([expires_at], map: "idx_refresh_tokens_expiry")
  @@index([token_family_id, issued_at(sort: Desc)], map: "idx_refresh_tokens_family")
}

model activations {
  id                        String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id           String                      @db.Uuid
  product_id                String                      @db.Uuid
  license_id                String                      @db.Uuid
  device_id                 String                      @db.Uuid
  status                    activation_status           @default(active)
  activated_at              DateTime                    @default(now()) @db.Timestamptz(6)
  last_seen_at              DateTime                    @default(now()) @db.Timestamptz(6)
  released_at               DateTime?                   @db.Timestamptz(6)
  revoked_at                DateTime?                   @db.Timestamptz(6)
  client_version            String?                     @db.VarChar(80)
  credential_hash           Bytes?
  credential_version        Int                         @default(1)
  token_version             Int                         @default(1)
  last_ip                   String?                     @db.Inet
  metadata                  Json                        @default("{}")
  activation_events         activation_events[]
  activation_refresh_tokens activation_refresh_tokens[]
  devices                   devices                     @relation(fields: [device_id, organization_id], references: [id, organization_id], onDelete: NoAction, onUpdate: NoAction)
  licenses                  licenses                    @relation(fields: [license_id, organization_id], references: [id, organization_id], onDelete: NoAction, onUpdate: NoAction)
  products                  products                    @relation(fields: [product_id, organization_id], references: [id, organization_id], onDelete: NoAction, onUpdate: NoAction)
  offline_grants            offline_grants[]

  @@unique([id, organization_id])
  @@unique([license_id, device_id], map: "uq_activation_license_device_active", where: raw("(status = 'active'::activation_status)"))
  @@unique([product_id, device_id], map: "uq_activation_product_device_active", where: raw("(status = 'active'::activation_status)"))
  @@index([device_id, status], map: "idx_activations_device_status")
  @@index([last_seen_at(sort: Desc)], map: "idx_activations_last_seen", where: raw("(status = 'active'::activation_status)"))
  @@index([license_id, status, activated_at(sort: Desc)], map: "idx_activations_license_status")
}

model admin_sessions {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  user_id         String        @db.Uuid
  token_hash      Bytes         @unique
  csrf_token_hash Bytes
  ip              String?       @db.Inet
  user_agent      String?
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  last_seen_at    DateTime      @default(now()) @db.Timestamptz(6)
  expires_at      DateTime      @db.Timestamptz(6)
  revoked_at      DateTime?     @db.Timestamptz(6)
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users           users         @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id, expires_at(sort: Desc)], map: "idx_admin_sessions_user")
}

model api_request_logs {
  id              BigInt   @id @default(autoincrement())
  organization_id String?  @db.Uuid
  product_id      String?  @db.Uuid
  request_id      String   @db.VarChar(100)
  method          String   @db.VarChar(10)
  route           String   @db.VarChar(180)
  response_status Int
  error_code      String?  @db.VarChar(80)
  latency_ms      Int
  ip              String?  @db.Inet
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  @@index([organization_id, response_status, created_at(sort: Desc)], map: "idx_api_logs_org_status_time")
  @@index([product_id, created_at(sort: Desc)], map: "idx_api_logs_product_time")
}

model audit_logs {
  id              BigInt   @id @default(autoincrement())
  organization_id String   @db.Uuid
  actor_type      String   @db.VarChar(30)
  actor_id        String?  @db.Uuid
  action          String   @db.VarChar(120)
  resource_type   String   @db.VarChar(80)
  resource_id     String?  @db.Uuid
  before_data     Json?
  after_data      Json?
  request_id      String?  @db.VarChar(100)
  ip              String?  @db.Inet
  user_agent      String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  @@index([organization_id, created_at(sort: Desc)], map: "idx_audit_org_time")
  @@index([resource_type, resource_id, created_at(sort: Desc)], map: "idx_audit_resource")
}

model backup_job_targets {
  id                          String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id             String                      @db.Uuid
  job_id                      String                      @db.Uuid
  destination_id              String                      @db.Uuid
  status                      backup_target_status        @default(queued)
  remote_uri                  String?
  remote_size_bytes           BigInt?
  checksum_sha256             String?                     @db.VarChar(64)
  uploaded_at                 DateTime?                   @db.Timestamptz(6)
  verified_at                 DateTime?                   @db.Timestamptz(6)
  retry_count                 Int                         @default(0)
  error_code                  String?                     @db.VarChar(80)
  error_message               String?
  backup_storage_destinations backup_storage_destinations @relation(fields: [destination_id], references: [id], onUpdate: NoAction)
  backup_jobs                 backup_jobs                 @relation(fields: [job_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organizations               organizations               @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([job_id, destination_id])
}

model backup_jobs {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id      String                 @db.Uuid
  policy_id            String?                @db.Uuid
  backup_id            String                 @unique @db.VarChar(80)
  status               backup_job_status      @default(queued)
  trigger              String                 @default("manual") @db.VarChar(40)
  started_at           DateTime?              @db.Timestamptz(6)
  finished_at          DateTime?              @db.Timestamptz(6)
  size_bytes           BigInt?
  local_path           String?
  manifest_sha256      String?                @db.VarChar(64)
  error_code           String?                @db.VarChar(80)
  error_message        String?
  created_by           String?                @db.Uuid
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  /// 保留策略清掉该作业备份文件的时间。作业记录本身永久保留（审计凭据），只清文件。
  purged_at            DateTime?              @db.Timestamptz(6)
  backup_job_targets   backup_job_targets[]
  users                users?                 @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organizations        organizations          @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  backup_policies      backup_policies?       @relation(fields: [policy_id], references: [id], onUpdate: NoAction)
  backup_restore_tests backup_restore_tests[]

  @@index([organization_id, created_at(sort: Desc)], map: "idx_backup_jobs_org_created")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model backup_policies {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id        String                  @db.Uuid
  name                   String                  @db.VarChar(120)
  scope                  String                  @default("database") @db.VarChar(40)
  schedule_cron          String                  @default("0 3 * * *") @db.VarChar(60)
  timezone               String                  @default("UTC") @db.VarChar(64)
  target_mode            backup_target_mode      @default(all_required)
  required_success_count Int?
  retention_json         Json                    @default("{\"daily\": 7, \"weekly\": 4, \"monthly\": 6}")
  verify_mode            backup_verify_mode      @default(sha256_and_manifest)
  bandwidth_limit_kbps   Int?
  parallelism            Int                     @default(2)
  encrypt                Boolean                 @default(true)
  enabled                Boolean                 @default(true)
  created_at             DateTime                @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                @default(now()) @db.Timestamptz(6)
  backup_jobs            backup_jobs[]
  organizations          organizations           @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  backup_policy_targets  backup_policy_targets[]

  @@unique([organization_id, name])
}

model backup_policy_targets {
  id                          String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id             String                      @db.Uuid
  policy_id                   String                      @db.Uuid
  destination_id              String                      @db.Uuid
  priority                    Int                         @default(100)
  is_required                 Boolean                     @default(true)
  backup_storage_destinations backup_storage_destinations @relation(fields: [destination_id], references: [id], onUpdate: NoAction)
  organizations               organizations               @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  backup_policies             backup_policies             @relation(fields: [policy_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([policy_id, destination_id])
}

model backup_restore_tests {
  id                          String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id             String                       @db.Uuid
  job_id                      String?                      @db.Uuid
  destination_id              String?                      @db.Uuid
  status                      backup_restore_status        @default(queued)
  test_environment            String                       @default("sandbox-schema") @db.VarChar(120)
  verified_checks_json        Json                         @default("[]")
  rpo_seconds                 Int?
  rto_seconds                 Int?
  error_message               String?
  started_at                  DateTime?                    @db.Timestamptz(6)
  finished_at                 DateTime?                    @db.Timestamptz(6)
  created_by                  String?                      @db.Uuid
  created_at                  DateTime                     @default(now()) @db.Timestamptz(6)
  users                       users?                       @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  backup_storage_destinations backup_storage_destinations? @relation(fields: [destination_id], references: [id], onUpdate: NoAction)
  backup_jobs                 backup_jobs?                 @relation(fields: [job_id], references: [id], onUpdate: NoAction)
  organizations               organizations                @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organization_id, created_at(sort: Desc)], map: "idx_backup_restore_tests_org_created")
}

model backup_storage_credentials {
  id                                                                                                 String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id                                                                                    String                        @db.Uuid
  destination_id                                                                                     String                        @db.Uuid
  ciphertext                                                                                         Bytes
  algorithm                                                                                          String                        @default("aes-256-gcm") @db.VarChar(40)
  key_version                                                                                        Int                           @default(1)
  fingerprint                                                                                        String?                       @db.VarChar(120)
  rotated_at                                                                                         DateTime?                     @db.Timestamptz(6)
  revoked_at                                                                                         DateTime?                     @db.Timestamptz(6)
  created_at                                                                                         DateTime                      @default(now()) @db.Timestamptz(6)
  backup_storage_destinations_backup_storage_credentials_destination_idTobackup_storage_destinations backup_storage_destinations   @relation("backup_storage_credentials_destination_idTobackup_storage_destinations", fields: [destination_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organizations                                                                                      organizations                 @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  backup_storage_destinations_backup_storage_destinations_credential_idTobackup_storage_credentials  backup_storage_destinations[] @relation("backup_storage_destinations_credential_idTobackup_storage_credentials")
}

model backup_storage_destinations {
  id                                                                                                String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id                                                                                   String                       @db.Uuid
  name                                                                                              String                       @db.VarChar(120)
  provider_type                                                                                     backup_provider_type
  adapter_type                                                                                      backup_adapter_type          @default(native)
