# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# 签名私钥与开发凭证私钥（绝不入库）
/.keys/

# 本地密钥与备份（绝不入库）；/.keys/ 已在上方列出，这里补齐分环境目录
/.keys-prod/
/.keys-sandbox/
/.backups/
/.backups-sandbox/

# 会话工具目录（DSH / Claude 本地状态）
/.dsh-uploads/
/.agents/
/.claude/

# 测试产物
/test-results/
/playwright-report/
/.playwright/

# Python 示例运行残留
__pycache__/
*.pyc

# Scalar standalone 构建产物（构建前由 scripts/copy-api-reference.mjs 从 node_modules 复制）
/public/vendor/scalar-standalone.js
