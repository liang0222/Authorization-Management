# ─────────────────────────────────────────────────────────────────────────────
# 授权 SaaS · 环境变量模板（规格 13 / 27）
#
#    cp .env.example .env
#
# 所有变量都有开发默认值（见 src/lib/config.ts），但生产部署必须显式覆盖，
# 下面标了 [必改] 的一个都不能漏 —— 生产启动时的安全闸门会逐项检查，
# 不满足就直接拒绝启动（`src/lib/security/boot-safety.ts` → instrumentation）。
#
# 命名注意：数据库变量叫 LICENSE_DB_URL 而不是 DATABASE_URL —— 避免继承到
# 环境中残留的、指向别处的同名变量（真实踩过，表现为 P1001 ECONNREFUSED）。
# 本文件不得包含任何真实密码、私钥或生产授权码。
# ─────────────────────────────────────────────────────────────────────────────

# ── 数据库 ───────────────────────────────────────────────────────────────────
# [必改] PostgreSQL 连接串。只监听回环或内网，绝不暴露公网。
LICENSE_DB_URL=postgresql://licensing:licensing_dev_pw@127.0.0.1:55432/licensing?schema=public

# ── 部署形态 ─────────────────────────────────────────────────────────────────
# production | sandbox | development
# sandbox 必须使用独立数据库、独立 SIGNING_KEY_DIR、独立 BACKUP_LOCAL_DIR
# 与独立产品凭证（product_credentials.environment='sandbox'）。
DEPLOYMENT_ENV=development

# [必改] 对外站点地址：用于密码重置链接与 Cookie 的 Secure 判定。
# 走 HTTPS 反代时填 https://licensing.example.com；只在内网调试填 http://127.0.0.1:3100。
APP_BASE_URL=http://127.0.0.1:3100

# ── 密钥（三把密钥必须互相独立，且都 >= 32 字节随机）────────────────────────
# 生成方式：node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"

# [必改] 会话签名密钥。换掉 = 所有管理员被强制重新登录。
SESSION_SECRET=dev-only-session-secret-please-change-in-production-32bytes

# [必改] 封存密钥（AES-256-GCM）：MFA 密钥、Webhook 签名密钥、备份存储凭证。
# 与 SESSION_SECRET 分开的原因：Cookie 与机密存储的生命周期不同，换会话密钥
# 不应该连带把密文全废掉。留空则回退到 SESSION_SECRET 派生（仅兼容旧数据）。
SECRETBOX_KEY=

# 轮换期间可解的旧封存密钥，逗号分隔，只读不解新数据。
# 用 `npx tsx scripts/rotate-secrets.mts --apply` 重封存后即可清空。
SECRETBOX_KEYS_LEGACY=

# [必改] 授权码 HMAC pepper。授权码明文不落库，换 pepper 后旧哈希无法重算，
# 所以轮换必须走版本环：新 pepper 写当前，旧 pepper 留在 *_LEGACY。
LICENSE_HMAC_PEPPER=dev-only-license-hmac-pepper-please-change-in-production
LICENSE_HMAC_PEPPER_VERSION=v1
# 旧 pepper 只在“客户端带着明文来校验”时就地重哈希，属于兼容期的只读密钥。
LICENSE_HMAC_PEPPER_LEGACY=
LICENSE_HMAC_PEPPER_LEGACY_VERSION=v1

# [必改] 备份包加密密钥（ZMBK1 信封）。与授权签名私钥、会话密钥都不同。
BACKUP_ENCRYPTION_KEY=dev-only-backup-encryption-key-please-change

# ── 授权签名 ─────────────────────────────────────────────────────────────────
# [必改] Ed25519 私钥目录。生产不得使用 .keys（开发目录），启动闸门会拦。
SIGNING_KEY_DIR=.keys
# 服务端断言（private_key_jwt）的 audience
ASSERTION_AUDIENCE=license-api

# ── 邮件 ─────────────────────────────────────────────────────────────────────
# 开发环境把重置密码链接直接返回给前端；生产必须 false，否则链接会泄露给调用方。
DEV_MAIL_SINK=true

# ── Webhook 投递器 ───────────────────────────────────────────────────────────
WEBHOOK_INTERVAL_MS=5000
DISABLE_WEBHOOK_WORKER=false
# Webhook 出站请求的 SSRF 防护在应用层实现；development 额外允许 http 回环地址。
BACKUP_ALERT_WEBHOOK_URL=

# ── 备份 ─────────────────────────────────────────────────────────────────────
# Local 暂存目录（同时是“必需目标”之一）。sandbox 必须与生产不同。
BACKUP_LOCAL_DIR=.backups
# 后台调度器的扫描间隔（默认 30 秒，最小 30 秒）
BACKUP_SCHEDULER_INTERVAL_MS=30000
DISABLE_BACKUP_SCHEDULER=false

# ── 可观测性 ─────────────────────────────────────────────────────────────────
# /metrics 的预共享令牌；不设置则该端点一律 401（反代层还会再 deny 一次）。
METRICS_TOKEN=
